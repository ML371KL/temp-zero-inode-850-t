[Unit]
Description=Т-Технологии 850 · таймер утреннего сбора

[Timer]
# Ежедневно 05:20 UTC = 08:20 МСК, после утренних тактов соседних панелей и
# через полчаса после соседнего банка семейства: оба сборщика форм ходят на
# SOAP ЦБ с одного адреса, а на плотные серии запросов ЦБ отвечает отказом.
# Ранний такт нужен ради невосполнимых источников: даты и формы ЦБ по
# регномеру (винтаж — «что было известно на дату»), снимки T-Invest; они отдают
# ТЕКУЩЕЕ состояние, пропущенный день не добирается никогда. По понедельникам
# такт ещё и гоняет тесты такта «в будущем» (+60 дней).
OnCalendar=*-*-* 05:20:00 UTC
RandomizedDelaySec=300
# Пропущенный из-за выключенной машины прогон догоняется при старте.
Persistent=true
Unit=t850-collect.service

[Install]
WantedBy=timers.target
