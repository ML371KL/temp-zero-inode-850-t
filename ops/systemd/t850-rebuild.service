[Unit]
Description=Т-Технологии 850 · пересборка выпуска при новом коде в main (без сбора)
Documentation=https://github.com/ML371KL/temp-zero-inode-850-t/blob/main/ops/README.md
# Проверка спрашивает GitHub (git fetch), публикация пушит в репозиторий данных.
Wants=network-online.target
After=network-online.target

[Service]
# Раз в 15 минут таймер будит `run.sh rebuild`. Почти всегда делать нечего:
# выход 0 без единой строки. Сначала дожимается сверка прошлого такта (если
# висит отметка release.pushed — один GET боевой двери). Если с опубликованного
# выпуска изменился код, который считает число (model, indicators, ops,
# data/assumptions, data/facts, data/indicators, data/checks, requirements.txt),
# — тесты такта, сборка, публикация и сверка на входах последнего такта.
#
# Перезапуска нет (Restart=no по умолчанию) — намеренно: упавшая пересборка не
# повторяется ни через 3 минуты, ни через 15 (run.sh помнит коммит в
# rebuild.tried), иначе красный набор тестов крутился бы на общем сервере без
# конца. Повтор — только с новым коммитом в main; на том же коде выпуск соберёт
# суточный такт.
Type=exec
User=dash
Group=dash
WorkingDirectory=/srv/dash/repo-850-t
# Env-файл читает сам run.sh (см. t850-collect.service): строки
# EnvironmentFile нет намеренно.
Environment=ENV_FILE=/usr/local/etc/t-850/env
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /srv/dash/repo-850-t/ops/run.sh rebuild
# Потолок = тесты такта + сборка + публикация + сверка до своего окна, с
# запасом; он же (вместе с дозором) задаёт LOCK_WAIT_SECONDS в run.sh. Потолок
# ниже настоящего времени убил бы пересборку на середине, rebuild.tried
# запомнил бы коммит, и выпуск на новом коде не вышел бы до вечера (урок 850oa).
# Число вписывает `python ops/tools/budgets.py --write` из ops/budgets.json;
# руками не правится, равенство сверяет tests/test_ops_units.py. Оценка это
# или замер сервера — ops/budgets.json, status (ops/README.md §9).
RuntimeMaxSec=4080
SyslogIdentifier=t850

StateDirectory=t-850
# Каталог состояния закрыт от прочих учётных записей сервера (сырой архив
# ответов источников, журналы, клон данных): без этой строки systemd при
# каждом старте юнита возвращает каталогу режим 0755.
StateDirectoryMode=0750
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
# Репозиторий пишется: git reset при обновлении кода, pip в .venv, var/ тестов.
# /srv/dash/.ssh нужен для чтения: публикация пушит через ssh-алиас ключа записи.
ReadWritePaths=/srv/dash/repo-850-t

# Сборка считает полосу пулом процессов; их число — `workers` бюджета (такт
# берёт его сам, когда BANK_WORKERS в env-файле пуст). Потолок памяти и число
# процессов стоят на ОДНОМ замере (ops/budgets.json, ops/README.md §9): числа
# вписывает `python ops/tools/budgets.py --write`. Оценка это или замер
# сервера — ops/budgets.json, status.
MemoryHigh=832M
MemoryMax=1024M
Nice=10

# Мост тревог: шлёт СМЕНУ состояния, поэтому тихие проверки с кодом 0 ничего не
# присылают, упавшая пересборка приходит один раз, а «снова проходит» — когда
# выпуск на новом коде всё же вышел.
ExecStopPost=-+/usr/local/sbin/dash-alert %n

# Секции [Install] намеренно НЕТ: юнит запускается таймером.
