[Unit]
Description=Т-Технологии 850 · таймер суточного прогона

[Timer]
# Будни 19:00 UTC = 22:00 МСК, после суточных тактов соседних панелей: сервер
# общий, и две сборки разом растягивают обе. Основная сессия MOEX закрывается
# в 18:40 МСК, ISS отдаёт итоги дня; кривая бескупонной доходности — тем же
# вечером. В выходные новых торговых данных нет, и прогон дал бы тот же выпуск
# (выпуск с тем же хэшем повторно не публикуется).
OnCalendar=Mon..Fri *-*-* 19:00:00 UTC
# Разброс, чтобы не бить по ISS ровно в ту же секунду, что соседние панели.
RandomizedDelaySec=300
# Пропущенный из-за выключенной машины прогон догоняется при старте.
Persistent=true
Unit=t850-daily.service

[Install]
WantedBy=timers.target
