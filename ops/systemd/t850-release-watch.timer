[Unit]
Description=Т-Технологии 850 · таймер дозора релизов (будни, каждые 10 минут 09:00–18:00 МСК)

[Timer]
# 06:00–14:50 UTC = 09:00–17:50 МСК: пресс-релизы МСФО эмитент выкладывает в
# первые часы московского утра, прочие документы — до конца рабочего дня
# (data/indicators/sources.yaml, schedule.watch_window_msk). Минуты кратны 10 —
# мимо проверок соседнего банка семейства. Дни релиза выбирает сам такт (тихая
# проверка окна по календарю индикаторов): вне окна — выход без строки, поэтому
# ширина окна почти бесплатна.
OnCalendar=Mon..Fri *-*-* 06..14:00/10:00 UTC
RandomizedDelaySec=30
AccuracySec=30s
# Persistent не нужен: пропущенная проверка ничего не теряет — следующая через
# 10 минут, а суточный такт вечером соберёт всё принятое.
Unit=t850-release-watch.service

[Install]
WantedBy=timers.target
